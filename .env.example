# Angel One SmartAPI Credentials
# Copy this file to .env and fill in your own details.
# NEVER share your .env file, commit it to git, or paste it into a chat/AI tool.
# If a credential is ever exposed (uploaded, committed, pasted anywhere),
# rotate it immediately — treat it as compromised.

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PIN=your_4digit_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Trading Settings
CAPITAL=50000
TRANCHE_1_PCT=0.33
TRANCHE_2_PCT=0.33
TRANCHE_3_PCT=0.34
TRIGGER_1=-2.0
TRIGGER_2=-4.0
TRIGGER_3=-6.0
MAX_PREMIUM_PCT=0.5
DAILY_LOSS_LIMIT=5000
MONTHLY_BUDGET=1500

# Telegram alerts (optional but recommended)
# 1. Open Telegram, search @BotFather, /newbot -> get token
# 2. Search @userinfobot -> get your chat_id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
