# ============================================================
#  ETF Trading Bot — environment configuration
#  Copy this file to .env and fill in your values.
#
#  NEVER commit .env to git.
#  NEVER share credentials in chat, email, or screenshots.
#  If a credential is ever exposed, rotate it immediately.
# ============================================================

# ── Angel One SmartAPI credentials ──────────────────────────
# API key: smartapi.angelbroking.com → My Apps → your app
ANGEL_API_KEY=your_api_key_here

# Your Angel One login ID (e.g. A123456)
ANGEL_CLIENT_ID=your_client_id_here

# Your 4-digit trading PIN
ANGEL_PIN=your_4digit_pin_here

# TOTP base32 secret key — shown when you enable TOTP in the
# Angel One app (the long text string, not the 6-digit OTP)
ANGEL_TOTP_SECRET=your_totp_secret_here

# ── Bot run mode ─────────────────────────────────────────────
# "dry"  = simulate everything, no real orders (safe default)
# "live" = real orders, real money
MODE=alert_only

# ── Budget & risk ────────────────────────────────────────────
# Total budget available per calendar month (₹)
MONTHLY_BUDGET=1500

# Maximum fraction of monthly budget spendable on any one day
# 0.33 = 33% cap per day (so budget lasts across multiple dip days)
# Range: 0.05 – 1.0
DAILY_CAP_PCT=0.33

# If today's total spend would exceed this limit (₹), stop buying
# for the rest of the day.  Set high to effectively disable.
DAILY_LOSS_LIMIT=5000

# ── NAV check mode ────────────────────────────────────────────
# "advisory" (default) — log NAV premium, only hard-block above 2%.
#                         Per-ETF max_premium still switches to LIMIT orders.
# "strict"              — treat per-ETF max_premium as a WAIT threshold.
# Note: mfapi.in returns the PREVIOUS day's declared NAV, not live iNAV.
NAV_CHECK_MODE=advisory

# ── Telegram alerts (optional but strongly recommended) ───────
# 1. Open Telegram → search @BotFather → /newbot → copy token
# 2. Search @userinfobot → copy your chat_id
# Leave blank to disable (alerts will only appear in log files)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional second recipient (backup Telegram chat ID)
TELEGRAM_CHAT_ID_2=
