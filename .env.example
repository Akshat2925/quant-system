# ============================================================
#  ETF Trading Bot — environment configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git. NEVER share credentials.
#  If a credential is ever exposed, rotate it immediately.
# ============================================================

# ── Angel One SmartAPI credentials ──────────────────────────
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PIN=your_4digit_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# ── Groww Trade API credentials (optional, read-only) ────────
# Get from groww.in/trade-api → API keys → Generate API key
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# ── Bot run mode ─────────────────────────────────────────────
# "alert_only" (DEFAULT) — signals only, NO orders placed
# "dry_run"              — simulated orders, separate state files
# "live"                 — real orders (requires confirmation)
MODE=alert_only

# ── Budget & risk ────────────────────────────────────────────
MONTHLY_BUDGET=1500
DAILY_CAP_PCT=0.33
DAILY_LOSS_LIMIT=5000

# ── NAV check mode ────────────────────────────────────────────
# "advisory" — log premium, only hard-block above 2%
# "strict"   — per-ETF max_premium is the WAIT threshold
NAV_CHECK_MODE=advisory

# ── Telegram alerts (optional but recommended) ───────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_2=

# ── Static IP for live orders (optional) ─────────────────────
REGISTERED_STATIC_IP=

# ── Sync intervals (minutes) ─────────────────────────────────
GROWW_SYNC_MINUTES=30
ANGEL_SYNC_MINUTES=30

# ── Price staleness guard (seconds) ──────────────────────────
PRICE_STALE_SECONDS=120
